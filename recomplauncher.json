{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "repo": "Hexveil404/PokeZ-ARecomp",
  "name": "ZA Recomp",
  "inputs": [
    {
      "id": "game",
      "label": "Pokemon Legends: Z-A 1.0.0, 2.0.0 or 2.0.2",
      "formats": [
        {
          "type": "folder"
        },
        {
          "type": "file",
          "extensions": [
            "nup"
          ]
        },
        {
          "type": "file",
          "extensions": [
            "nsp",
            "xci"
          ],
          "requires": [
            "keys",
            "title-keys"
          ]
        }
      ]
    },
    {
      "id": "update",
      "label": "Game update 2.0.0 or 2.0.2 (.nsp)",
      "role": "update",
      "optional": true,
      "formats": [
        {
          "type": "file",
          "extensions": [
            "nsp"
          ],
          "requires": [
            "keys",
            "title-keys"
          ]
        }
      ]
    },
    {
      "id": "dlc",
      "label": "Mega Dimension DLC (.nsp; requires game 2.0.0 or newer)",
      "role": "dlc",
      "optional": true,
      "formats": [
        {
          "type": "file",
          "extensions": [
            "nsp"
          ],
          "requires": [
            "keys",
            "title-keys"
          ]
        }
      ]
    },
    {
      "id": "keys",
      "label": "Nintendo Switch prod.keys",
      "role": "key",
      "shared": "switch.prod-keys"
    },
    {
      "id": "title-keys",
      "label": "Nintendo Switch title.keys",
      "role": "key",
      "shared": "switch.title-keys"
    }
  ],
  "start": {
    "program": [
      "lasrecomp.exe",
      "AppRun",
      "zarecomp",
      "ZA Recomp-linux-x86_64.AppImage"
    ],
    "args": [
      "--play"
    ]
  },
  "prepare": {
    "program": [
      "lasrecomp.exe",
      "AppRun",
      "zarecomp",
      "ZA Recomp-linux-x86_64.AppImage"
    ],
    "args": [
      "--prepare",
      "--game={input:game}",
      "--update={input:update}",
      "--dlc={input:dlc}",
      "--keys={input:keys}",
      "--title-keys={input:title-keys}"
    ],
    "label": "Import and compile your game",
    "done": [
      "{data}/extracted/.recomplauncher-ready"
    ],
    "keeps_copy": true
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [{ "path": "{data}/larecomp.ini" }],
      "ensure": {
        "video_recommended": "done"
      }
    }
  ],
  "saves": [
    "{data}/save",
    "{data}/larecomp.ini"
  ],
  "folders": {
    "game": [
      {
        "path": "{data}/extracted"
      }
    ],
    "saves": [
      {
        "path": "{data}/save"
      }
    ],
    "logs": [
      {
        "path": "{data}/logs"
      }
    ],
    "mods": [
      {
        "path": "{data}/mods"
      }
    ],
    "cache": [
      {
        "path": "{data}/cache"
      }
    ]
  },
  "actions": [
    {
      "id": "mods",
      "label": "Open mods folder",
      "open": "mods"
    },
    {
      "id": "logs",
      "label": "Open logs folder",
      "open": "logs"
    }
  ],
  "exit_codes": {
    "3": "ok"
  },
  "system": {
    "windows": {
      "version": "10.0.18362",
      "graphics": {
        "vulkan": "1.2"
      }
    },
    "linux": {
      "graphics": {
        "vulkan": "1.3"
      }
    }
  },
  "settings": [
    {
      "id": "fullscreen",
      "label": "Display mode",
      "group": "Display",
      "choices": [
        {
          "label": "Windowed",
          "set": {
            "fullscreen": "0"
          }
        },
        {
          "label": "Fullscreen",
          "set": {
            "fullscreen": "1"
          }
        }
      ],
      "defaults": {
        "fullscreen": "0"
      }
    },
    {
      "id": "resolution",
      "label": "Resolution",
      "group": "Display",
      "choices": [
        {
          "label": "Match display",
          "set": {
            "resolution": "match",
            "video_recommended": "done"
          }
        },
        {
          "label": "25%",
          "set": {
            "resolution": "25%",
            "video_recommended": "done"
          }
        },
        {
          "label": "50%",
          "set": {
            "resolution": "50%",
            "video_recommended": "done"
          }
        },
        {
          "label": "75%",
          "set": {
            "resolution": "75%",
            "video_recommended": "done"
          }
        },
        {
          "label": "1080p",
          "set": {
            "resolution": "1",
            "video_recommended": "done"
          }
        },
        {
          "label": "1620p",
          "set": {
            "resolution": "1.5x",
            "video_recommended": "done"
          }
        },
        {
          "label": "2160p",
          "set": {
            "resolution": "2",
            "video_recommended": "done"
          }
        },
        {
          "label": "3240p",
          "set": {
            "resolution": "3",
            "video_recommended": "done"
          }
        },
        {
          "label": "4320p",
          "set": {
            "resolution": "4",
            "video_recommended": "done"
          }
        },
        {
          "label": "Dynamic",
          "set": {
            "resolution": "dynamic",
            "video_recommended": "done"
          }
        }
      ],
      "defaults": {
        "resolution": "1.5x"
      }
    },
    {
      "id": "fps60",
      "label": "Frame rate",
      "group": "Display",
      "choices": [
        {
          "label": "30 FPS",
          "set": {
            "fps60": "0",
            "video_recommended": "done"
          }
        },
        {
          "label": "60 FPS",
          "set": {
            "fps60": "1",
            "video_recommended": "done"
          }
        }
      ],
      "defaults": {
        "fps60": "1"
      }
    },
    {
      "id": "fps60_lock",
      "label": "Keep 60 FPS when performance drops",
      "group": "Display",
      "choices": [
        {
          "label": "Off",
          "set": {
            "fps60_lock": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "fps60_lock": "1"
          }
        }
      ],
      "defaults": {
        "fps60_lock": "1"
      }
    },
    {
      "id": "present_mode",
      "label": "Presentation",
      "group": "Display",
      "choices": [
        {
          "label": "VSync",
          "set": {
            "present_mode": "fifo"
          }
        },
        {
          "label": "Mailbox",
          "set": {
            "present_mode": "mailbox"
          }
        }
      ],
      "defaults": {
        "present_mode": "fifo"
      }
    },
    {
      "id": "show_fps",
      "label": "Show frame rate",
      "group": "Display",
      "choices": [
        {
          "label": "Off",
          "set": {
            "show_fps": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "show_fps": "1"
          }
        }
      ],
      "defaults": {
        "show_fps": "0"
      }
    },
    {
      "id": "upscaler",
      "label": "Upscaling",
      "group": "Graphics",
      "choices": [
        {
          "label": "Bilinear",
          "set": {
            "upscaler": "bilinear"
          }
        },
        {
          "label": "AMD FSR 1",
          "set": {
            "upscaler": "fsr1"
          }
        }
      ],
      "defaults": {
        "upscaler": "fsr1"
      }
    },
    {
      "id": "antialias",
      "label": "Anti-aliasing",
      "group": "Graphics",
      "choices": [
        {
          "label": "Off",
          "set": {
            "antialias": "off"
          }
        },
        {
          "label": "SMAA",
          "set": {
            "antialias": "smaa"
          }
        }
      ],
      "defaults": {
        "antialias": "smaa"
      }
    },
    {
      "id": "aniso16",
      "label": "High quality texture filtering",
      "group": "Graphics",
      "choices": [
        {
          "label": "Off",
          "set": {
            "aniso16": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "aniso16": "1"
          }
        }
      ],
      "defaults": {
        "aniso16": "1"
      }
    },
    {
      "id": "shadow_resolution",
      "label": "Shadow resolution",
      "group": "Graphics",
      "choices": [
        {
          "label": "1x",
          "set": {
            "shadow_resolution": "1"
          }
        },
        {
          "label": "2x",
          "set": {
            "shadow_resolution": "2"
          }
        },
        {
          "label": "4x",
          "set": {
            "shadow_resolution": "4"
          }
        }
      ],
      "defaults": {
        "shadow_resolution": "1"
      }
    },
    {
      "id": "ambient_occlusion",
      "label": "Ambient occlusion",
      "group": "Graphics",
      "choices": [
        {
          "label": "Off",
          "set": {
            "ambient_occlusion": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "ambient_occlusion": "1"
          }
        }
      ],
      "defaults": {
        "ambient_occlusion": "0"
      }
    },
    {
      "id": "indirect_light",
      "label": "Indirect light",
      "group": "Graphics",
      "choices": [
        {
          "label": "Off",
          "set": {
            "indirect_light": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "indirect_light": "1"
          }
        }
      ],
      "defaults": {
        "indirect_light": "0"
      }
    },
    {
      "id": "tex_hd",
      "label": "HD texture packs",
      "group": "Graphics",
      "choices": [
        {
          "label": "Off",
          "set": {
            "tex_hd": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "tex_hd": "1"
          }
        }
      ],
      "defaults": {
        "tex_hd": "0"
      }
    },
    {
      "id": "volume",
      "label": "Volume",
      "group": "Audio",
      "slider": {
        "key": "volume",
        "min": 0,
        "max": 2,
        "step": 0.05,
        "format": "%.2f"
      },
      "defaults": {
        "volume": "1.00"
      }
    },
    {
      "id": "reverb",
      "label": "Reverb",
      "group": "Audio",
      "choices": [
        {
          "label": "Off",
          "set": {
            "reverb": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "reverb": "1"
          }
        }
      ],
      "defaults": {
        "reverb": "1"
      }
    },
    {
      "id": "movie_audio",
      "label": "Cutscene audio",
      "group": "Audio",
      "choices": [
        {
          "label": "Off",
          "set": {
            "movie_audio": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "movie_audio": "1"
          }
        }
      ],
      "defaults": {
        "movie_audio": "1"
      }
    },
    {
      "id": "prompts",
      "label": "Button icons",
      "group": "Controls",
      "choices": [
        {
          "label": "Automatic",
          "set": {
            "prompts": "auto"
          }
        },
        {
          "label": "Nintendo",
          "set": {
            "prompts": "nintendo"
          }
        },
        {
          "label": "Xbox",
          "set": {
            "prompts": "xbox"
          }
        },
        {
          "label": "PlayStation",
          "set": {
            "prompts": "playstation"
          }
        },
        {
          "label": "Keyboard",
          "set": {
            "prompts": "keyboard"
          }
        },
        {
          "label": "Steam Deck",
          "set": {
            "prompts": "steamdeck"
          }
        }
      ],
      "defaults": {
        "prompts": "auto"
      }
    },
    {
      "id": "rumble",
      "label": "Controller vibration",
      "group": "Controls",
      "choices": [
        {
          "label": "Off",
          "set": {
            "rumble": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "rumble": "1"
          }
        }
      ],
      "defaults": {
        "rumble": "1"
      }
    },
    {
      "id": "background_input",
      "label": "Controller input in background",
      "group": "Controls",
      "choices": [
        {
          "label": "Off",
          "set": {
            "background_input": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "background_input": "1"
          }
        }
      ],
      "defaults": {
        "background_input": "0"
      }
    },
    {
      "id": "battle_abxy_position",
      "label": "Battle moves by button position",
      "group": "Controls",
      "choices": [
        {
          "label": "Off",
          "set": {
            "battle_abxy_position": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "battle_abxy_position": "1"
          }
        }
      ],
      "defaults": {
        "battle_abxy_position": "0"
      }
    },
    {
      "id": "xbox_attack_layout",
      "label": "Xbox battle layout",
      "group": "Controls",
      "choices": [
        {
          "label": "Off",
          "set": {
            "xbox_attack_layout": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "xbox_attack_layout": "1"
          }
        }
      ],
      "defaults": {
        "xbox_attack_layout": "0"
      }
    },
    {
      "id": "mouse_sens",
      "label": "Mouse sensitivity",
      "group": "Controls",
      "slider": {
        "key": "mouse_sens",
        "min": 0.1,
        "max": 5,
        "step": 0.05,
        "format": "%.2f"
      },
      "defaults": {
        "mouse_sens": "1.0"
      }
    }
  ]
}
